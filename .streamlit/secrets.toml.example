# Скопируйте в .streamlit/secrets.toml (файл в .gitignore, в репозиторий не попадёт)
# и заполните. На Streamlit Cloud то же содержимое вставляется в
# Manage app → Settings → Secrets.

# --- YandexGPT (веб-версия; работает и локально) ---------------------------
# API-ключ сервисного аккаунта Yandex Cloud с ролью ai.languageModels.user
YANDEX_GPT_API_KEY = ""
# ID каталога, в котором создан сервисный аккаунт (вида b1g...)
YANDEX_GPT_FOLDER_ID = ""
# Необязательно: yandexgpt/latest (по умолчанию) или yandexgpt-lite/latest
# YANDEX_GPT_MODEL = "yandexgpt/latest"

# --- Anthropic (локальная версия) ------------------------------------------
# Корпоративный гейтвей или https://api.anthropic.com
# ANTHROPIC_BASE_URL = "https://api.anthropic.com"
# ANTHROPIC_AUTH_TOKEN = ""
# ANTHROPIC_MODEL = "claude-sonnet-5"

# Если заданы оба провайдера, по умолчанию выбирается Anthropic.
# LLM_PROVIDER = "yandex"

# --- Источник цен -----------------------------------------------------------
# Прокси для запросов к Google Flights, если Google блокирует IP облака капчей.
# GF_PROXY = "http://user:pass@host:port"
